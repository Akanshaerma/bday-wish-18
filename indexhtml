<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Meri Jaan ❤️</title>
    <style>
        body {
            background-color: #0b0f19;
            color: #e6edf3;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
            position: relative;
        }

        /* Floating background elements */
        .bg-glow {
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(88, 166, 255, 0.1);
            filter: blur(80px);
            border-radius: 50%;
            z-index: -1;
        }

        .card {
            background: rgba(22, 27, 34, 0.85);
            backdrop-filter: blur(10px);
            padding: 40px 30px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8);
            text-align: center;
            border: 1px solid #30363d;
            max-width: 420px;
            width: 90%;
            z-index: 10;
            animation: fadeIn 1.2s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h1 {
            color: #58a6ff;
            font-size: 22px;
            margin-bottom: 15px;
            font-family: monospace;
        }

        p {
            font-size: 15px;
            line-height: 1.6;
            color: #8b949e;
            margin-bottom: 15px;
        }

        .highlight {
            color: #ff7b72;
            font-weight: bold;
        }

        .heart {
            color: #f85149;
            font-size: 22px;
            animation: pulse 1.2s infinite;
            display: inline-block;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }

        .btn {
            background-color: #238636;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            margin-top: 15px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(35, 134, 54, 0.4);
        }

        .btn:hover {
            background-color: #2ea043;
            transform: scale(1.05);
        }

        .footer-note {
            font-size: 12px;
            color: #484f58;
            margin-top: 25px;
            font-family: monospace;
        }
    </style>
</head>
<body>

    <div class="bg-glow"></div>

    <div class="card">
        <h1>// 🎂 BDAY_PROTOCOL.EXE</h1>
        <p>Happy Birthday to my favorite <span class="highlight">bug-fixer</span> and permanent core logic! <span class="heart">❤️</span></p>
        <p>Wishing you a year with zero runtime errors, high performance, and infinite happiness.</p>
        <button class="btn" id="loveBtn" onclick="revealMessage()">Click to Deploy Love</button>
        <div class="footer-note">Hint: Press F12 & check Console! 🕵️‍♂️</div>
    </div>

    <script>
        // Console secret message
        console.log("%c ❤️ SPECIAL SYSTEM NOTICE ❤️ ", "background: #161b22; color: #ff7b72; font-size: 16px; padding: 6px; border-radius: 4px; font-weight: bold;");
        console.log("Hey coder! If you are reading this secret console log, just know that you mean the absolute world to me. Happy Birthday! ✨🚀");

        function revealMessage() {
            const btn = document.getElementById('loveBtn');
            btn.innerHTML = "Status: Madly in Love with You! 🥰";
            btn.style.backgroundColor = "#da3633";
            btn.style.boxShadow = "0 4px 12px rgba(218, 54, 51, 0.4)";
        }
    </script>

</body>
</html>